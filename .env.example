# ============================================================
# TBBA ERP - Environment Variables Template
# Copy this file to ".env" and replace the placeholder values.
# Never commit the real ".env" file to version control.
# ============================================================

# --- Application ------------------------------------------------
# local for development, production for the live server.
APP_ENV=local
# Public URL without a trailing slash.
# Root domain example: https://yourdomain.com
# Subfolder example:   https://yourdomain.com/Bridge
APP_URL=http://localhost/Bridge
# Use false on the production server.
APP_DEBUG=true

# --- Database ---------------------------------------------------
# Use a dedicated least-privilege account in production; never root.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tbba_erp
DB_USER=tbba_app
DB_PASS=

# Comma-separated IP addresses or CIDR ranges of reverse proxies that are
# allowed to supply CF-Connecting-IP / X-Forwarded-For. Leave blank when the
# application is reached directly.
TRUSTED_PROXIES=

# --- Account Security / Two-Factor Authentication ---------------
# REQUIRED before enabling 2FA. Generate once with:
# openssl rand -hex 32
# Keep this value unchanged; changing it invalidates stored 2FA secrets.
SECURITY_ENCRYPTION_KEY=

# --- Google Sign-In (OAuth 2.0) ---------------------------------
# Create a Web application OAuth client in Google Cloud Console.
# These credentials are for "Sign in with Google", not Google Authenticator.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override. Leave blank to build it from APP_URL.
GOOGLE_REDIRECT_URI=
# Register this exact callback in Google Cloud Console:
# {APP_URL}/index.php?action=google_callback

# --- Security Email ----------------------------------------------
# Sender address used by password-reset and login-alert emails.
# Use an address on a domain that your mail server is authorised to send from.
SECURITY_MAIL_FROM=no-reply@yourdomain.com

# Use smtp for authenticated SMTP or mail for the server's native mail().
MAIL_TRANSPORT=smtp
MAIL_HOST=
MAIL_PORT=587
# Typical values: tls, ssl, or none (depends on the mail provider).
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@yourdomain.com
MAIL_FROM_NAME="TBBA Security"

# --- Firebase Web Push -------------------------------------------
# Firebase Console > Project Settings > General > Your apps > Web app
FCM_API_KEY=
FCM_AUTH_DOMAIN=your-project-id.firebaseapp.com
FCM_PROJECT_ID=your-project-id
FCM_STORAGE_BUCKET=your-project-id.firebasestorage.app
FCM_MESSAGING_SENDER_ID=
FCM_APP_ID=

# Firebase Console > Project Settings > Cloud Messaging
# > Web Push certificates. Generate a key pair if one does not exist.
FCM_VAPID_KEY=

# Relative path to the service-account JSON downloaded from:
# Firebase Console > Project Settings > Service accounts
FIREBASE_CREDENTIALS_PATH=config/service-account.json

# --- Google Drive ------------------------------------------------
# Store this JSON outside public_html on the production server.
GOOGLE_DRIVE_CREDENTIALS_PATH=config/google-credentials.json
# ID of the master Drive folder used by the document integration.
GDRIVE_MASTER_FOLDER_ID=
