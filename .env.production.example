# ============================================================
# TBBA ERP - DirectAdmin Production Environment
# Copy to .env inside public_html and replace every CHANGE_ME value.
# Set .env permission to 600 and never place credentials in a public repo.
# ============================================================

# --- Application ------------------------------------------------
APP_ENV=production
APP_URL=https://CHANGE_ME_DOMAIN
APP_DEBUG=false

# --- DirectAdmin MySQL ------------------------------------------
# DirectAdmin commonly prefixes DB_NAME and DB_USER with the account username.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=CHANGE_ME_DAUSER_database
DB_USER=CHANGE_ME_DAUSER_dbuser
DB_PASS=CHANGE_ME_STRONG_DATABASE_PASSWORD

# Leave blank for a direct connection. Add only trusted proxy IP/CIDR values.
TRUSTED_PROXIES=

# Generate once with: openssl rand -hex 32
# When transferring the existing DB, retain the current value so 2FA remains valid.
SECURITY_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS

# --- Google Sign-In ---------------------------------------------
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=https://CHANGE_ME_DOMAIN/index.php?action=google_callback

# --- Password reset and security email --------------------------
SECURITY_MAIL_FROM=no-reply@CHANGE_ME_DOMAIN
MAIL_TRANSPORT=smtp
MAIL_HOST=mail.CHANGE_ME_DOMAIN
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=no-reply@CHANGE_ME_DOMAIN
MAIL_PASSWORD=CHANGE_ME_EMAIL_PASSWORD
MAIL_FROM_ADDRESS=no-reply@CHANGE_ME_DOMAIN
MAIL_FROM_NAME="TBBA Security"

# --- Firebase Web Push ------------------------------------------
FCM_API_KEY=CHANGE_ME
FCM_AUTH_DOMAIN=CHANGE_ME.firebaseapp.com
FCM_PROJECT_ID=CHANGE_ME
FCM_STORAGE_BUCKET=CHANGE_ME.firebasestorage.app
FCM_MESSAGING_SENDER_ID=CHANGE_ME
FCM_APP_ID=CHANGE_ME
FCM_VAPID_KEY=CHANGE_ME

# Store credential JSON files above public_html, for example:
# /home/DAUSER/domains/DOMAIN/private_credentials/service-account.json
FIREBASE_CREDENTIALS_PATH=/home/CHANGE_ME_DAUSER/domains/CHANGE_ME_DOMAIN/private_credentials/service-account.json

# --- Google Drive event gallery --------------------------------
GOOGLE_DRIVE_CREDENTIALS_PATH=/home/CHANGE_ME_DAUSER/domains/CHANGE_ME_DOMAIN/private_credentials/google-credentials.json
GDRIVE_MASTER_FOLDER_ID=CHANGE_ME

# --- Optional / reserved assistant integration -----------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

